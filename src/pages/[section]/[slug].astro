---
import { render } from "astro:content";

import YouTubePlayer from "../../components/YouTubePlayer.astro";
import { mdxComponents } from "../../components/mdx-components.ts";
import { authorRegistry, sectionRegistry } from "../../config/registries.ts";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getPreviewArticles, getPublicArticles } from "../../lib/articles.ts";
import { pathParamsFor } from "../../lib/content-contract.ts";

export async function getStaticPaths() {
  const articles = import.meta.env.DEV
    ? await getPreviewArticles()
    : await getPublicArticles();

  return articles.map((article) => ({
    params: pathParamsFor(article),
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const section = sectionRegistry[
  article.data.section as keyof typeof sectionRegistry
];
const author = authorRegistry[
  article.data.author as keyof typeof authorRegistry
];
const dateFormatter = new Intl.DateTimeFormat("ar", {
  dateStyle: "long",
  timeZone: "UTC",
});
const formatDate = (date: string) =>
  dateFormatter.format(new Date(`${date}T00:00:00.000Z`));
---

<SiteLayout>
  <article>
    <h1>{article.data.title}</h1>
    <dl class="article-facts">
      <div>
        <dt>القسم:</dt>
        <dd><a href={`/${section.slug}/`}>{section.label}</a></dd>
      </div>
      <div>
        <dt>الكاتب:</dt>
        <dd><a href="/عن-أحمد-المنجاوي/">{author.name}</a></dd>
      </div>
      <div>
        <dt>نُشر في:</dt>
        <dd>
          <time datetime={article.data.publishedAt}
            ><bdi dir="auto">{formatDate(article.data.publishedAt)}</bdi></time
          >
        </dd>
      </div>
      {
        article.data.updatedAt && (
          <div>
            <dt>حُدّثت المادة في:</dt>
            <dd>
              <time datetime={article.data.updatedAt}>
                <bdi dir="auto">{formatDate(article.data.updatedAt)}</bdi>
              </time>
            </dd>
          </div>
        )
      }
    </dl>
    <section class="article-summary">
      <h2>الخلاصة</h2>
      <p>{article.data.summary}</p>
    </section>
    <Content components={mdxComponents} />
    {
      article.data.references?.length ? (
        <section class="article-references">
          <h2>المراجع</h2>
          <ul>
            {article.data.references.map((reference) => (
              <li>
                <a href={reference.url}>{reference.label}</a>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }
    <YouTubePlayer
      youtubeId={article.data.youtubeId}
      title={article.data.title}
    />
  </article>
</SiteLayout>

<style>
  article {
    min-inline-size: 0;
  }

  article > :global(*) {
    min-inline-size: 0;
  }

  article :global(h3) {
    color: #1c1917;
    font-weight: 700;
    text-wrap: balance;
  }

  h1 {
    margin-block: 0 32px;
  }

  article :global(h2) {
    margin-block: 32px 16px;
  }

  article :global(h3) {
    margin-block: 24px 8px;
    font-size: 1.125rem;
    line-height: 1.9;
  }

  article :global(p),
  article :global(ul),
  article :global(ol),
  article :global(blockquote) {
    margin-block: 0 16px;
  }

  article :global(ul),
  article :global(ol) {
    padding-inline-start: 24px;
  }

  article :global(blockquote) {
    margin-inline: 0;
    border-inline-start: 1px solid #78716c;
    padding-inline-start: 16px;
    color: #57534e;
  }

  .article-facts {
    display: grid;
    gap: 8px;
    margin-block: 0 32px;
    color: #57534e;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.6;
  }

  .article-facts > div {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
  }

  .article-facts dd {
    margin: 0;
  }

  .article-summary {
    margin-block-end: 32px;
    border-inline-start: 1px solid #78716c;
    background: #f5f1e8;
    padding: 16px;
  }

  .article-summary h2 {
    margin-block: 0 8px;
  }

  .article-summary p {
    margin: 0;
  }

  article :global(code) {
    direction: ltr;
    font-family: inherit;
    unicode-bidi: isolate;
  }

  .article-references {
    margin-block-start: 48px;
  }

  .article-references h2 {
    margin-block-start: 0;
  }

  article :global(.media-continuation) {
    margin-block-start: 48px;
  }

  article :global(.media-continuation h2) {
    margin-block-start: 0;
  }

  article :global(.video-privacy-note) {
    margin-block-end: 16px;
  }

  article :global(.video-region) {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 100%;
    min-inline-size: 0;
    aspect-ratio: 16 / 9;
    background: #f5f1e8;
  }

  article :global(.video-region iframe) {
    inline-size: 100%;
    block-size: 100%;
    border: 0;
  }

  article :global([data-video-activate]:not([hidden])) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 44px;
    min-inline-size: 44px;
    max-inline-size: calc(100% - 32px);
    border: 2px solid #166534;
    background: transparent;
    color: #166534;
    padding-block: 8px;
    padding-inline: 16px;
    font: inherit;
    text-align: center;
  }

  article :global([data-video-error]:not([hidden])) {
    max-inline-size: calc(100% - 32px);
    margin: 0;
    text-align: center;
  }

  article :global([data-video-activate]:focus-visible),
  article :global(.video-region:has(iframe):focus-within) {
    outline: 3px solid #166534;
    outline-offset: 3px;
  }

  article :global(.youtube-cta) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 44px;
    min-inline-size: 44px;
    margin-block-start: 16px;
    background: #166534;
    color: #fffdf8;
    padding-block: 8px;
    padding-inline: 16px;
    text-align: center;
  }

  article :global(.youtube-cta:hover) {
    background: #14532d;
  }

  @media (min-width: 48rem) {
    .article-summary {
      padding: 24px;
    }
  }
</style>
