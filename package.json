{
  "name": "ahmed-el-mangawy-blog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "scripts": {
    "preinstall": "node -e \"const npm=process.env.npm_config_user_agent?.match(/^npm\\/([^ ]+)/)?.[1];if(process.version!=='v24.19.0'||npm!=='11.17.0'){console.error('Required: Node v24.19.0 and npm 11.17.0; selected: '+process.version+' and npm '+(npm??'unknown'));process.exit(1)}\"",
    "dev": "astro dev",
    "preview": "astro preview",
    "test": "node -e \"const {spawnSync}=require('node:child_process');const r=spawnSync(process.execPath,['--test','--test-concurrency=1','--test-reporter=tap','tests/content-contract.test.ts','tests/site-origin.test.ts','tests/deployment-measurement.test.ts'],{encoding:'utf8'});process.stdout.write((r.stdout+r.stderr).replaceAll('\\\\\\\\','\\\\'));process.exit(r.status??1)\"",
    "test:browser": "npm run build && playwright test",
    "check": "astro check",
    "build": "astro build",
    "launch:ready": "node scripts/launch-ready.mjs",
    "verify": "npm test && npm run check && npm run test:browser"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.8",
    "@astrojs/sitemap": "3.7.3",
    "@mdx-js/mdx": "3.1.1",
    "astro": "7.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "typescript": "6.0.3"
  }
}
